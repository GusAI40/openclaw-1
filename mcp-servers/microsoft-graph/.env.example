# Azure AD app (client-credentials flow, app-only)
MS_CLIENT_ID=your-app-registration-client-id
MS_CLIENT_SECRET=your-app-registration-client-secret
MS_TENANT_ID=your-tenant-id

# Optional: default mailbox UPN used when a tool call omits `user`.
# If unset, every tool call MUST pass `user` explicitly.
# MS_DEFAULT_USER=user@yourtenant.onmicrosoft.com
