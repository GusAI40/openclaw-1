# ============================================================================
# OpenClaw — TAG AI Production Environment (Hetzner / Coolify)
# ============================================================================
# Target server : tagai-cloud (87.99.148.242)  Hetzner CPX21
# Domain        : openclaw.ubntag.com  (Cloudflare DNS, proxy OFF)
# Reverse proxy : Traefik (Coolify-managed, Let's Encrypt)
# Container user: node (uid 1000)  — see openclaw/Dockerfile USER directive
#
# Usage:
#   1. Copy this file to .env in the Coolify build context (or paste the values
#      into Coolify's "Environment Variables" panel, marking secrets as such).
#   2. Generate every secret marked with `# generate via:` BEFORE first deploy.
#   3. Mount the host paths under OPENCLAW_CONFIG_DIR / OPENCLAW_WORKSPACE_DIR
#      as persistent Coolify volumes (see DEPLOY_HETZNER.md, "Persistent volumes").
#   4. Never commit a populated copy of this file. .env.tagai.example is the
#      only version that should land in git.
# ============================================================================


# === Image & runtime ========================================================
# Image tag built+pushed by Coolify from the GusAI40/openclaw-1 repo.
# `openclaw:tagai` is TAG-AI's local convention; Coolify will tag the build
# with this name when set in the project's "Image Name" field.
OPENCLAW_IMAGE=openclaw:tagai

# Timezone for both gateway and CLI containers. Gus is in Argyle, TX (Central).
# Mirrors the override in docker-compose.tagai.yml. Change if the founder
# relocates or if a client deployment needs a different TZ.
OPENCLAW_TZ=America/Chicago


# === Gateway network binding ================================================
# Public-facing port the gateway listens on inside the container.
# Traefik in Coolify routes openclaw.ubntag.com -> this port.
# Do NOT change without also updating the Traefik labels in
# docker-compose.tagai.yml.
OPENCLAW_GATEWAY_PORT=18789

# Bridge / pairing port (used by openclaw-cli sidecar and remote pairing).
# Kept loopback-only via the shared network namespace; no Traefik exposure.
OPENCLAW_BRIDGE_PORT=18790

# Bind mode. MUST be `lan` when the container sits behind Traefik / Docker
# bridge networking — `loopback` makes the gateway unreachable from the
# reverse proxy. Valid values: lan | loopback | custom | tailnet | auto.
OPENCLAW_GATEWAY_BIND=lan

# Shared-secret token Coolify/Traefik clients (and you, browsing the
# Control UI at https://openclaw.ubntag.com) present to the gateway.
# REQUIRED in production — without it the gateway either refuses external
# requests or runs in `--allow-unconfigured` mode (insecure).
# generate via: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Allow agent connections over plain ws:// when the gateway is on a private
# network. KEEP EMPTY (false) in production — Cloudflare + Traefik terminate
# TLS, so the public path is always wss://. Only set to `1` for local debug.
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=


# === Persistent storage =====================================================
# Host paths Coolify must mount as persistent volumes. Inside the container
# these become /home/node/.openclaw and /home/node/.openclaw/workspace
# (the upstream Dockerfile runs as the `node` uid 1000 user — Coolify must
# `chown 1000:1000` these directories before first start).
#
# We point them at /home/tagai/.openclaw on the host so they live alongside
# the founder's other tagai-user state and get picked up by the daily Hetzner
# snapshot. Do NOT use /root/.openclaw (the upstream Hetzner doc default) —
# TAG AI policy forbids running anything as root on this VPS.
OPENCLAW_CONFIG_DIR=/home/tagai/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/tagai/.openclaw/workspace


# === Claude session credentials =============================================
# These are OPTIONAL but required if you want the gateway/CLI to call into
# claude.ai (web session) or claude code (CLI session) on behalf of agents.
# Leave blank if every agent uses an Anthropic API key directly via
# auth-profiles.json (the recommended path for a server deploy).
#
# How to obtain CLAUDE_AI_SESSION_KEY:
#   - Run `claude login` locally, then read ~/.claude/.credentials.json
#     (the `sessionKey` field). Paste the value here.
#
# How to obtain CLAUDE_WEB_SESSION_KEY / CLAUDE_WEB_COOKIE:
#   - Open claude.ai in a logged-in browser, DevTools -> Application ->
#     Cookies -> https://claude.ai. Copy the `sessionKey` cookie value
#     into CLAUDE_WEB_SESSION_KEY, and the full cookie header (all
#     name=value pairs joined with `; `) into CLAUDE_WEB_COOKIE.
#   - These rotate; expect to refresh roughly every 30 days.
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=


# === OpenClaw config / keyring ==============================================
# Password used by the gnome-keyring stand-in inside the container to
# encrypt cached provider secrets at rest. Does NOT need to match anything
# else — pick a fresh random value per environment.
# generate via: openssl rand -hex 32
GOG_KEYRING_PASSWORD=

# XDG config root inside the container. The gateway expects everything
# under /home/node/.openclaw — leave this exactly as is unless you have
# changed the volume layout.
XDG_CONFIG_HOME=/home/node/.openclaw


# === Sandbox (optional, off by default) =====================================
# Uncomment and set if you build the image with --build-arg
# OPENCLAW_INSTALL_DOCKER_CLI=1 and want agents.defaults.sandbox enabled.
# DOCKER_GID must equal the host's docker group gid:
#   ssh tagai@87.99.148.242 'stat -c "%g" /var/run/docker.sock'
# DOCKER_GID=999


# === Build-time arguments (passed at docker build, not runtime) ============
# These are documented here for operator reference. Set them in Coolify's
# "Build Arguments" panel, NOT as runtime env vars — the Dockerfile only
# reads them via ARG during the build stage.
#
# OPENCLAW_VARIANT=default              # default | slim
# OPENCLAW_INSTALL_BROWSER=             # set to 1 to bake Chromium (~300MB)
# OPENCLAW_INSTALL_DOCKER_CLI=          # set to 1 to enable sandbox backend
# OPENCLAW_DOCKER_APT_PACKAGES=         # extra apt packages, space-separated
# OPENCLAW_EXTENSIONS=                  # opt-in plugins, space-separated
