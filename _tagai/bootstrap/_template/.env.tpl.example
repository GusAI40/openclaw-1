# .env.tpl.example — sanitized structure of the per-tenant env template.
# The REAL _template/.env.tpl contains live secrets and is git-ignored (see .gitignore).
# On a fresh box, restore the real .env.tpl from the encrypted backup, OR fill these in.
# Placeholders use {{NAME}} (substituted by bootstrap-tenant.sh) or <FILL> (set by hand).

# --- identity / tenant ---
TENANT_ID={{TENANT_ID}}
TENANT_NAME={{TENANT_NAME}}
DOMAIN={{DOMAIN}}
OWNER_EMAIL=<FILL: owner@example.com>

# --- gateway / runtime ---
OPENCLAW_GATEWAY_TOKEN={{GATEWAY_TOKEN}}
OPENCLAW_GATEWAY_PORT={{GATEWAY_PORT}}
OPENCLAW_BRIDGE_PORT={{BRIDGE_PORT}}
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=false
OPENCLAW_CONFIG_DIR={{CONFIG_DIR}}
OPENCLAW_WORKSPACE_DIR={{WORKSPACE_DIR}}
XDG_CONFIG_HOME={{CONFIG_DIR}}
OPENCLAW_IMAGE=openclaw:tagai
OPENCLAW_IMAGE_VERSION=2026.4.25
OPENCLAW_TZ=America/Chicago

# --- provider keys (real values live in encrypted backup / shared env, NOT here) ---
DEEPSEEK_API_KEY=<FILL>
HERMES_OPENAI_KEY=<FILL>

# --- channel: telegram ---
TELEGRAM_BOT_TOKEN=<FILL: from @BotFather>
TELEGRAM_ALLOWED_USERS=<FILL: numeric user id(s)>
TELEGRAM_HOME_CHANNEL=
