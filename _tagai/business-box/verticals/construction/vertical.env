# Construction vertical — overlay metadata.
# Sourced by deploy-vertical.sh. POSIX-sh compatible (KEY=value, no spaces).
# These values are NOT secrets — they shape the tenant's identity + skill set.

VERTICAL_ID=construction
VERTICAL_NAME="Construction"

# One-line role used in the tenant system-prompt overlay (see system-prompt.overlay.md).
VERTICAL_TAGLINE="the back-office brain for a construction company — quotes, scheduling, lead intake, and follow-up."

# Skill bundle directory copied into the tenant workspace at deploy time.
VERTICAL_SKILLS_DIR=skills
